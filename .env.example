# Copia in .env (non versionato) e adatta. Docker Compose lo legge per sostituire le variabili.

# Deve coincidere con DB_PASSWORD di .prod.env. scripts/ripristina-export.sh lo ricava da lì.
POSTGRES_PASSWORD=<REDACTED>

# Porta pubblicata sull'host. Finché il firewall DOCKER-USER non è attivo resta su 127.0.0.1
# e si prova con un tunnel SSH. In esercizio la raggiunge il reverse proxy di dhwp.
MERGIN_PORT=127.0.0.1:8086
# MERGIN_PORT=90.147.144.148:8086
